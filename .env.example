# ── Ports ─────────────────────────────────────────────────────────────
# The ONLY port exposed to your host machine.
# After startup, open http://localhost:8080
FRONTEND_PORT=8080

# ── LLM (Ollama) ──────────────────────────────────────────────────────
# Any model you have pulled into Ollama. See README "Swapping the model".
# qwen2.5:1.5b (~1GB) = light + reliable citations, fast on CPU. Good default.
# Lighter: qwen2.5:0.5b (397MB, faster but weaker). Bigger: llama3.1:8b (best, slow on CPU).
OLLAMA_MODEL=llama3.1:8b
# 0.0 = deterministic/factual, higher = more creative. Kept low for RAG.
LLM_TEMPERATURE=0.2

# ── RAG / Search ──────────────────────────────────────────────────────
# Default number of sources fed to the AI answer. Users can change this live in
# the UI (and regenerate); MAX_SOURCES is the ceiling they can dial up to.
RESULT_COUNT=5
MAX_SOURCES=20

# Creativity of the plain "Chat" tab (higher = more creative than RAG answers).
CHAT_TEMPERATURE=0.6

# Per-source "Summarize with AI": when true, it fetches the source page and
# summarizes its text. Set to false to summarize from the SearXNG snippet only
# and make ZERO external page requests (strict privacy).
ALLOW_PAGE_FETCH=true

# Top-right "exit location" widget. Makes ONE cached geo-IP lookup (ipwho.is)
# to show what the web sees as your location. Set false to make zero such calls.
SHOW_LOCATION=true

# NOTE: SearXNG's secret_key is NOT set here. It lives in
# searxng/settings.yml and is generated locally by `make setup`
# (or `npm run setup`) so it never sits in an env file or version control.

# ── VPN (optional) ────────────────────────────────────────────────────
# Only used when you start with the VPN override:
#   make up-vpn   /   npm run up-vpn
# Routes SearXNG's outbound traffic through a VPN (Gluetun). Fill in the
# block for YOUR provider and leave the rest blank.

# Provider: custom | mullvad | protonvpn | nordvpn | pia | surfshark | ...
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard

# ── Option A: Custom / self-hosted WireGuard (works with ANY provider) ─
# Paste the values from your .conf file:
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=            # e.g. 10.2.0.2/32
WIREGUARD_PUBLIC_KEY=          # the peer/server PublicKey
WIREGUARD_ENDPOINT_IP=         # server IP from the Endpoint line
WIREGUARD_ENDPOINT_PORT=51820

# ── Option B: Mullvad (set VPN_SERVICE_PROVIDER=mullvad) ──────────────
#   WIREGUARD_PRIVATE_KEY=<your key>
#   WIREGUARD_ADDRESSES=<your address>
#   VPN_SERVER_COUNTRIES=Sweden

# ── Option C: Proton VPN (set VPN_SERVICE_PROVIDER=protonvpn) ─────────
#   WIREGUARD_PRIVATE_KEY=<from Proton's WireGuard config generator>
#   VPN_SERVER_COUNTRIES=Switzerland

# ── Option D: OpenVPN-based providers (NordVPN, PIA, Surfshark, …) ────
# Set VPN_TYPE=openvpn and fill these:
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=

# Docker subnets allowed to bypass the tunnel (so the API can reach SearXNG).
# The default covers standard docker networks; only change if yours differ.
VPN_LAN_SUBNETS=172.16.0.0/12
